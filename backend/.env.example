# Copy this file to ".env" and adjust if needed:
#   cp .env.example .env
#
# These defaults match the database defined in docker-compose.yml
# (user "teachhub", password "teachhub", database "teachhub", host port 5433).
# If you start the DB with `docker compose up -d`, this works as-is.

DATABASE_URL="postgresql://teachhub:teachhub@localhost:5433/teachhub?schema=public"

# The secret used to sign JWT login tokens.
# TODO(junior): the code doesn't read this yet — wiring it up is a task in
# docs/junior-dev-tasks.md (Task 1.6).
JWT_SECRET="change-me-in-a-real-app"
