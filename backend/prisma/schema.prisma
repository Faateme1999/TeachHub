// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

// Prisma Client is a JavaScript/TypeScript library that Prisma generates for us
// TypeScript to SQL

datasource db {
  provider = "postgresql"
}

// NOTE: this is a Prisma enum. It becomes a real Postgres enum type in the DB and
// a TypeScript `Role` union in the generated client — so you can write `Role.ADMIN`.
enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  // A User has many Enrollments, The [] means: Array,Many,List
  submissions Submission[]
  passwordResetTokens  PasswordResetToken[]
  createdCourses Course[]
}
// @id means: This is the Primary Key, Every value must be unique, It cannot be null,Prisma uses it to identify each row.


model PasswordResetToken{
  id           Int        @id @default(autoincrement())
  userId       Int  
  token        String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user      User     @relation(fields: [userId], references: [id])
}


model Course{
  id            Int       @id  @default(autoincrement()) 
  title         String
  description   String
  price         Float
  createdAt     DateTime  @default(now())

  createdById   Int
  createdBy     User      @relation(fields: [createdById], references: [id])

  //No enrollments column,It tells Prisma: A User can have many Enrollments
  // do NOT appear as columns anywhere.
  // Many students can enroll in the same course.
  enrollments Enrollment[]
  lessons     Lesson[]
  // One Course has many Lessons.
}


model Enrollment {
  id        Int      @id @default(autoincrement())

  userId    Int
  courseId  Int

// Because Prisma wants to know: userId points to which table?
// These are NOT columns, These are Prisma relation fields, They help Prisma understand: How tables are connected

  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  //course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum LessonType{
  RECORDED
  LIVE
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  videoData   Bytes?
  videoKey    String?
  hasVideo    Boolean    @default(false)
  meetingUrl  String?
  type      LessonType  

// Each Lesson belongs to one Course.
// courseId (foreign key)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])

  //course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Then create a migration so the database is updated:
  //   npx prisma migrate dev --name cascade_delete
  
  createdAt DateTime @default(now())
  outcomes Outcome[]

  assignments Assignment[]
  missionReview MissionReview?
  missionDiagnosticTests   MissionDiagnosticTest[]
}

// One-to-Many relationship
// Course (1) ──────< Lesson (Many)
// Foreign key lives on the "Many" side.

model Outcome{
  id        Int     @id @default(autoincrement())
  text      String
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  diagnosticQuestions DiagnosticQuestion[]
}

enum MissionType {
  REVIEW
  DIAGNOSTIC
}

model MissionReview {
  id        Int      @id @default(autoincrement())
  title     String
  type      MissionType
  order     Int

  lessonId Int    @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  content  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MissionDiagnosticTest {
  id  Int  @id @default(autoincrement())
  title     String
  type      MissionType
  order     Int
    
  lessonId  Int      
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions  DiagnosticQuestion[]
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}


model DiagnosticQuestion{
  id     Int   @id @default(autoincrement())
  text   String
  topic     String
  type   QuestionType
  order  Int

  testId   Int
  test  MissionDiagnosticTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  outcomeId Int
  outcome   Outcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)

  options DiagnosticOption[]
}

model DiagnosticOption{
  id           Int    @id @default(autoincrement())
  text         String
  isCorrect    Boolean
  order        Int

  questionId   Int
  question     DiagnosticQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}


model Assignment{
id  Int       @id @default(autoincrement())
title String
description String? 
deadline   DateTime?
lessonId Int

lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

submissions Submission[]

createdAt DateTime @default(now())
}

model Submission{
id Int   @id @default(autoincrement())  

assignmentId Int
assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

userId Int
user User @relation(fields: [userId], references: [id], onDelete: Cascade)

fileName String
fileData Bytes

submittedAt   DateTime  @default(now())

feedback   String?
correctedFileName String?
correctedFileData Bytes?

createdAt DateTime  @default(now())

@@unique([userId, assignmentId])
  // @@unique([userId, assignmentId], name: "user_assignment_unique")
}

